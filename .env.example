# 复制为 .env 后使用：cp .env.example .env
# .env 已被 .gitignore 忽略，不得提交真实密码。
# 本文件只提供本地开发占位值，不是生产配置。

POSTGRES_DB=snowfield
POSTGRES_USER=snowfield
POSTGRES_PASSWORD=REPLACE_WITH_YOUR_LOCAL_PASSWORD
POSTGRES_PORT=5433

# JWT HMAC 密钥至少32个随机字节；这里只是占位符，不得在仓库提交真实密钥。
SNOWFIELD_JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
SNOWFIELD_CORS_ALLOWED_ORIGIN=http://localhost:5173
